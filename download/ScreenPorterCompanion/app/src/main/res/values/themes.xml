<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base theme — light -->
    <style name="Theme.ScreenPorter" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/brand_background</item>
        <item name="colorSurface">@color/brand_surface</item>
        <item name="colorOnSurface">@color/brand_text_primary</item>
        <item name="colorError">@color/status_error</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/brand_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowBackground">@color/brand_background</item>
    </style>

    <style name="ScreenPorter.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="contentPadding">@dimen/card_padding</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/brand_border</item>
    </style>

    <style name="ScreenPorter.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="ScreenPorter.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="strokeColor">@color/brand_border</item>
        <item name="android:textColor">@color/brand_text_primary</item>
    </style>

    <style name="ScreenPorter.TextAppearance.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textColor">@color/brand_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ScreenPorter.TextAppearance.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/brand_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ScreenPorter.TextAppearance.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/brand_text_secondary</item>
    </style>

    <style name="ScreenPorter.TextAppearance.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/brand_text_tertiary</item>
    </style>

</resources>
