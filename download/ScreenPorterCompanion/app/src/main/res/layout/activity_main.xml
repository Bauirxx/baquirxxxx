<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <!-- Header / Brand -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_xl">

            <ImageView
                android:layout_width="@dimen/logo_size"
                android:layout_height="@dimen/logo_size"
                android:src="@drawable/ic_logo"
                android:contentDescription="@string/app_name" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_lg"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textAppearance="@style/ScreenPorter.TextAppearance.Headline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_subtitle"
                    android:textAppearance="@style/ScreenPorter.TextAppearance.Caption"
                    android:textColor="@color/brand_primary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Page title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/install_title"
            android:textAppearance="@style/ScreenPorter.TextAppearance.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:layout_marginBottom="@dimen/spacing_xl"
            android:text="@string/install_subtitle"
            android:textAppearance="@style/ScreenPorter.TextAppearance.Body" />

        <!-- Step 1: Server -->
        <com.google.android.material.card.MaterialCardView
            style="@style/ScreenPorter.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="@dimen/icon_size_md"
                        android:layout_height="@dimen/icon_size_md"
                        android:src="@drawable/ic_computer"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:text="@string/step_server_title"
                        android:textAppearance="@style/ScreenPorter.TextAppearance.Title"
                        android:textSize="@dimen/text_subtitle" />

                    <TextView
                        android:id="@+id/textStep1Status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/permission_missing"
                        android:textAppearance="@style/ScreenPorter.TextAppearance.Caption"
                        android:textColor="@color/status_warning" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/step_server_desc"
                    android:textAppearance="@style/ScreenPorter.TextAppearance.Body" />

                <Button
                    android:id="@+id/btnScanQr"
                    style="@style/ScreenPorter.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/action_qr_scan" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="Ou preencha manualmente:"
                    android:textAppearance="@style/ScreenPorter.TextAppearance.Caption" />

                <EditText
                    android:id="@+id/editServerAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:hint="@string/step_server_hint"
                    android:inputType="textUri"
                    android:autofillHints="server_address"
                    android:background="@drawable/bg_button_outline"
                    android:padding="@dimen/spacing_md" />

                <EditText
                    android:id="@+id/editServerUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:hint="@string/step_server_user"
                    android:inputType="text"
                    android:autofillHints="username"
                    android:background="@drawable/bg_button_outline"
                    android:padding="@dimen/spacing_md" />

                <EditText
                    android:id="@+id/editServerPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:hint="@string/step_server_password"
                    android:inputType="textPassword"
                    android:autofillHints="password"
                    android:background="@drawable/bg_button_outline"
                    android:padding="@dimen/spacing_md" />

                <Button
                    android:id="@+id/btnSaveServer"
                    style="@style/ScreenPorter.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/step_server_save" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 1.5: Consent (GuardianLink) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/ScreenPorter.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="@dimen/icon_size_md"
                        android:layout_height="@dimen/icon_size_md"
                        android:src="@drawable/ic_lock"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:text="@string/consent_title"
                        android:textAppearance="@style/ScreenPorter.TextAppearance.Title"
                        android:textSize="@dimen/text_subtitle" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/consent_warning"
                    android:textAppearance="@style/ScreenPorter.TextAppearance.Body" />

                <Button
                    android:id="@+id/btnOpenConsent"
                    style="@style/ScreenPorter.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/action_open_consent_sign" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 2: Permissions -->
        <com.google.android.material.card.MaterialCardView
            style="@style/ScreenPorter.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="@dimen/icon_size_md"
                        android:layout_height="@dimen/icon_size_md"
                        android:src="@drawable/ic_lock"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:text="@string/step_permissions_title"
                        android:textAppearance="@style/ScreenPorter.TextAppearance.Title"
                        android:textSize="@dimen/text_subtitle" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/step_permissions_desc"
                    android:textAppearance="@style/ScreenPorter.TextAppearance.Body" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerPermissions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="4"
                    tools:listitem="@layout/item_permission" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 3: Connect -->
        <com.google.android.material.card.MaterialCardView
            style="@style/ScreenPorter.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="@dimen/icon_size_md"
                        android:layout_height="@dimen/icon_size_md"
                        android:src="@drawable/ic_power"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:text="@string/step_connect_title"
                        android:textAppearance="@style/ScreenPorter.TextAppearance.Title"
                        android:textSize="@dimen/text_subtitle" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/step_connect_desc"
                    android:textAppearance="@style/ScreenPorter.TextAppearance.Body" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/textStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/status_disconnected"
                        android:textAppearance="@style/ScreenPorter.TextAppearance.Body"
                        android:textColor="@color/brand_text_secondary" />

                    <TextView
                        android:id="@+id/textMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:text="@string/mode_unknown"
                        android:textAppearance="@style/ScreenPorter.TextAppearance.Caption"
                        android:textColor="@color/brand_primary"
                        android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnToggleConnect"
                    style="@style/ScreenPorter.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/connect_button" />

                <Button
                    android:id="@+id/btnSosToggle"
                    style="@style/ScreenPorter.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/sos_enable" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 4: Protection (optional) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/ScreenPorter.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="@dimen/icon_size_md"
                        android:layout_height="@dimen/icon_size_md"
                        android:src="@drawable/ic_lock"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:text="@string/step_protection_title"
                        android:textAppearance="@style/ScreenPorter.TextAppearance.Title"
                        android:textSize="@dimen/text_subtitle" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/step_protection_desc"
                    android:textAppearance="@style/ScreenPorter.TextAppearance.Body" />

                <Button
                    android:id="@+id/btnEnableProtection"
                    style="@style/ScreenPorter.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/step_protection_title" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:gravity="center"
            android:text="@string/footer_consent"
            android:textAppearance="@style/ScreenPorter.TextAppearance.Caption"
            android:textColor="@color/brand_text_tertiary" />

        <TextView
            android:id="@+id/textVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:gravity="center"
            android:textAppearance="@style/ScreenPorter.TextAppearance.Caption"
            android:textColor="@color/brand_text_tertiary"
            tools:text="ScreenPorter Companion v0.1.0" />
    </LinearLayout>
</ScrollView>
