<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permite cleartext HTTP/WS para o servidor do utilizador (LAN / Tailscale).
         As regras <domain> NAO suportam CIDR (o Android ignora-as), por isso
         permite-se cleartext na base-config — necessario para ligar a um IP por
         http/ws em testes (Android 9+ bloqueia por omissao). -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
